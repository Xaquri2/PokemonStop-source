    ds_list_clear(textList);
    ds_list_clear(iconList);
    ds_list_clear(nameList);

if (test == true) 
{
ds_list_add(textList, "TRUE!!",)
ds_list_add(iconList, sprite_index,)
ds_list_add(nameList, "Gash's Mom",)
}
else 
{
ds_list_add(textList, "FALSE!!",)
ds_list_add(iconList, sprite_index,)
ds_list_add(nameList, "Gash's Mom",)
}
