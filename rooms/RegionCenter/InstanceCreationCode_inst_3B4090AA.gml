ds_list_add(textList, "Oh! Hello!", "I'm Mr. Banana.", "I run the region center around here!",
"Notice the carpet... it makes a map of the region!", 
"See, this green part I'm standing on is Mallet Town, and the bigger green area to the north is Route -1.",
"Then it branches into the three areas!")
