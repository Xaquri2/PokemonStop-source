if (global.potion == true) {
	ds_list_add(textList, "Have you tried this Human Stew?!","So freaking good!")
	ds_list_add(iconList, sprite_index,sprite_index)
	ds_list_add(nameList, "Morlock","Morlock")
}
else {
ds_list_add(textList, "Hsss!")
ds_list_add(iconList, sprite_index)
ds_list_add(nameList, "Morlock")
}