if (global.potion == true) {
	ds_list_add(textList, "I hate drinking alone...","Why am I even here?","I'm so lonely...")
	ds_list_add(iconList, sprite_index,sprite_index,sprite_index)
	ds_list_add(nameList, "Morlock","Morlock","Morlock")
}
else {
ds_list_add(textList, "Hsss!")
ds_list_add(iconList, sprite_index)
ds_list_add(nameList, "Morlock")
}